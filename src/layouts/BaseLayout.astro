---
import '@fontsource-variable/archivo';
import '@fontsource-variable/jetbrains-mono';

import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Seo } from 'astro-seo-meta';
import { Schema } from 'astro-seo-schema';
import { contact, site } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Shravonix — Enterprise CCTV & Surveillance Systems · Anand, Nadiad, Gujarat',
  description = site.description,
} = Astro.props;

const url = new URL(Astro.url.pathname, Astro.site).toString();
const SITE_URL = site.url;
const OG = `${SITE_URL}/og.jpg`;

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${SITE_URL}/#business`,
  name: site.name,
  slogan: site.tagline,
  description: site.description,
  url: SITE_URL,
  logo: `${SITE_URL}/mark.png`,
  image: OG,
  telephone: contact.phoneHref.replace('tel:', ''),
  email: contact.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Anand',
    addressRegion: 'Gujarat',
    addressCountry: 'IN',
  },
  areaServed: ['Anand', 'Nadiad', 'Kheda', 'Ahmedabad', 'Vadodara', 'Gujarat'],
  openingHours: 'Mo-Sa 09:00-19:00',
  priceRange: '$$',
  knowsAbout: ['CCTV installation', 'Surveillance systems', 'IP cameras', 'NVR systems', 'Annual maintenance contracts', 'Remote monitoring'],
};

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: site.name,
  description: site.description,
  url: SITE_URL,
  inLanguage: 'en',
  publisher: { '@id': `${SITE_URL}/#business` },
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={url} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="apple-touch-icon" href="/mark.png" />
    <Seo
      title={title}
      description={description}
      icon="/favicon.ico"
      themeColor="#f6f7f9"
      colorScheme="light"
      robots="index, follow"
      facebook={{ image: OG, url, type: 'website' }}
      twitter={{ image: OG, card: 'summary_large_image' }}
    />
    <Schema item={businessSchema as any} />
    <Schema item={siteSchema as any} />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-[var(--paper)] font-sans antialiased">
    <!--
      DIRECTION CONTRACT — The Quotation Sheet (seed 053f1a97)
      THESIS: the site reads like the honest technical document a buyer keeps:
      figure plates, spec tables, a numbered process — refusing both the neon
      control-room costume and the generic corporate template.
      OWN-WORLD: paper white (#f6f7f9), white plates separated by hairline
      rules (never shadow), ink-navy text, Shravonix blue as the structural
      accent, mono only as data voice, stamp chips for process states, Archivo
      wide caps for display. No glow, no surveillance chrome, no dark mode.
      STORY: the visitor understands Shravonix supplies, installs and maintains
      CCTV across Anand–Nadiad; believes it is engineering-led; acts on a free
      site survey.
      FIRST VIEWPORT: left — display headline "We design CCTV systems. We
      don't just sell them.", supporting line, blue survey CTA and a call link;
      right — white figure plate with the bullet-camera render and spec chips;
      coverage strip runs beneath.
      FORM: brief-pinned light replacement after user steer (the dark world
      read AI-generated); lineage: engineering datasheets & quotation
      documents; seed 053f1a97.
      FINISH: unreviewed and undocumented is unfinished; this build ends with
      the finish review, the verdict, DESIGN.md, and every shipping raster
      carrying its provenance.
    -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded focus:bg-[var(--blue)] focus:px-4 focus:py-2 focus:text-sm focus:text-white"
    >
      Skip to content
    </a>
    <Navbar />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Live timecodes for feed frames — data voice of the house.
      const tick = () => {
        const el = document.querySelector('[data-clock]');
        if (!el) return;
        const d = new Date();
        const p = (n: number) => String(n).padStart(2, '0');
        el.textContent = `${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`;
      };
      tick();
      setInterval(tick, 1000);

      // Single quiet entrance for sections.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
