---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';

import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Seo } from 'astro-seo-meta';
import { Schema } from 'astro-seo-schema';
import '../styles/global.css';

interface ResolvedAuthor {
  name: string;
  avatarUrl?: string;
  slug?: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  articleData?: any;
  resolvedAuthors?: ResolvedAuthor[];
}

const {
  title = 'Jainil Prajapati — Full-Stack Developer | AI Enthusiast',
  description = 'Full-Stack Developer passionate about building scalable SaaS platforms and contributing to open-source ecosystems. Built Writenex CMS, run Shravonix, and contribute to Dokploy.',
  image = 'https://jaainil.com/og.jpg',
  articleData = null,
  resolvedAuthors = null,
} = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
const currentUrl = url.toString();

const SITE_URL = 'https://jaainil.com';
const LOGO_URL = `${SITE_URL}/shravonix.png`;
const OG_FALLBACK = `${SITE_URL}/og.jpg`;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE_URL}/#person`,
  name: 'Jainil Prajapati',
  alternateName: 'jaainil',
  description: 'Full-Stack Developer passionate about building scalable SaaS platforms and contributing to open-source ecosystems.',
  url: SITE_URL,
  image: {
    '@type': 'ImageObject',
    url: 'https://storage.rxresu.me/clwlkfh7b0bgqtojz2itm0gc5/pictures/wtpe5ep6q61y0h1fkatnigk6.jpg',
    width: 512,
    height: 512,
  },
  email: 'jainilprajapati9@gmail.com',
  telephone: '+919725284302',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Anand',
    addressRegion: 'Gujarat',
    addressCountry: 'IN',
  },
  sameAs: [
    'https://www.linkedin.com/in/jaainil/',
    'https://github.com/jaainil',
    'https://www.npmjs.com/~imjp',
    'https://x.com/jaainil',
  ],
  knowsAbout: ['Web Development', 'SaaS', 'Open Source', 'AI/ML'],
  alumniOf: [
    {
      '@type': 'CollegeOrUniversity',
      name: 'Sardar Vallabhbhai Patel Institute of Technology',
    }
  ],
};

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: 'Jainil Prajapati Portfolio',
  alternateName: 'jaainil.com',
  description: 'Full-Stack Developer portfolio showcasing projects, experience, and open-source contributions.',
  url: SITE_URL,
  inLanguage: 'en',
  publisher: {
    '@id': `${SITE_URL}/#person`,
  },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${SITE_URL}/?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

const schemaAuthors = resolvedAuthors
  ? resolvedAuthors.map((a) => ({
      '@type': 'Person',
      name: a.name,
      ...(a.avatarUrl && { image: a.avatarUrl }),
      url: a.slug ? `${SITE_URL}/authors/${a.slug}` : SITE_URL,
    }))
  : articleData?.authors?.map((slug: string) => ({
      '@type': 'Person',
      name: slug,
      url: `${SITE_URL}/authors/${slug}`,
    }));

const articleSchema = articleData ? {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  '@id': `${currentUrl}#article`,
  headline: articleData.title,
  description: articleData.description,
  image: [image || OG_FALLBACK],
  author: schemaAuthors,
  datePublished: articleData.publishedAt instanceof Date ? articleData.publishedAt.toISOString() : articleData.publishedAt,
  dateModified: articleData.updatedAt
    ? (articleData.updatedAt instanceof Date ? articleData.updatedAt.toISOString() : articleData.updatedAt)
    : (articleData.publishedAt instanceof Date ? articleData.publishedAt.toISOString() : articleData.publishedAt),
  url: currentUrl,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': currentUrl,
  },
  isPartOf: {
    '@id': `${SITE_URL}/#website`,
  },
  publisher: {
    '@id': `${SITE_URL}/#person`,
  },
  inLanguage: 'en',
  ...(articleData.tags?.length && { keywords: articleData.tags.join(', ') }),
  ...(articleData.category && { articleSection: articleData.category }),
} : null;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (function() {
        var stored = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <link rel="canonical" href={currentUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/shravonix.png" />
    <Seo
      title={title}
      description={description}
      icon="/favicon.ico"
      themeColor="#000000"
      colorScheme="dark"
      robots="index, follow"
      facebook={{
        image: image,
        url: currentUrl,
        type: articleData ? 'article' : 'website'
      }}
      twitter={{
        image: image,
        site: '@jaainil',
        card: 'summary_large_image'
      }}
    />
    {articleSchema && <Schema item={articleSchema as any} />}
    <Schema item={personSchema as any} />
    <Schema item={siteSchema as any} />
    <slot name="head" />
  </head>
  <body style="background-color: var(--color-bg); color: var(--color-text-primary);" class="font-sans transition-colors duration-200">
    <div class="min-h-screen" style="background-color: var(--color-bg);">
      <div class="max-w-7xl mx-auto min-h-screen flex flex-col border-x" style="background-color: var(--color-surface); border-color: var(--color-border);">
        <Navbar />
        <main class="grow">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
  </body>
</html>