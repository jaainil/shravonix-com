        <div class="border p-6 transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)'" onmouseleave="this.style.backgroundColor=''">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-4">
            <div>
              <a href="https://remix-llm-resoures.vercel.app/" target="_blank" rel="noopener noreferrer" class="text-xl font-display font-bold hover:underline" style="color: var(--color-text-primary);" onmouseenter="this.style.color='var(--color-accent-text)'" onmouseleave="this.style.color='var(--color-text-primary)'">
                MemoryView AI Resources Hub
              </a>
              <span class="ml-3 text-xs font-mono uppercase tracking-widest" style="color: var(--color-text-muted);">150+ Resources</span>
