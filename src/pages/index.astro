---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Jainil Prajapati — Full-Stack Developer | AI Enthusiast"
  description="Full-Stack Developer passionate about building scalable SaaS platforms and contributing to open-source ecosystems. Built Writenex CMS, run Shravonix, and contribute to Dokploy."
>
  <div class="w-full pb-16">

    <!-- Hero Section -->
    <section class="border-b px-6 md:px-8 py-16" style="border-color: var(--color-border);">
      <div class="flex flex-col lg:flex-row gap-12 items-start">
        <div class="flex-1">
          <p class="text-[11px] font-mono uppercase tracking-widest mb-4" style="color: var(--color-text-muted);">// Portfolio</p>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold tracking-tight mb-4" style="color: var(--color-text-primary);">
            Jainil Prajapati
          </h1>
          <h2 class="text-xl md:text-2xl font-display font-bold tracking-tight mb-6" style="color: var(--color-accent-text);">
            Full-Stack Developer | AI Enthusiast
          </h2>
          <p class="text-base font-sans leading-relaxed max-w-2xl mb-8" style="color: var(--color-text-secondary);">
            Full-Stack Developer passionate about building scalable SaaS platforms and contributing to open-source ecosystems. Built and maintain Writenex CMS (npm published), run Shravonix (5K+ monthly readers, 90+ PageSpeed), and actively contribute to Dokploy's open-source templates.
          </p>
          <div class="flex flex-wrap gap-4">
            <a
              href="mailto:jainilprajapati9@gmail.com"
              class="inline-flex items-center gap-2 px-6 py-3 border text-xs font-mono uppercase tracking-widest transition-colors"
              style="border-color: var(--color-text-primary); color: var(--color-text-primary);"
              onmouseenter="this.style.backgroundColor='var(--color-text-primary)';this.style.color='var(--color-surface)'"
              onmouseleave="this.style.backgroundColor='';this.style.color='var(--color-text-primary)'"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              Email
            </a>
            <a
              href="https://www.linkedin.com/in/jaainil/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3 border text-xs font-mono uppercase tracking-widest transition-colors"
              style="border-color: var(--color-text-primary); color: var(--color-text-primary);"
              onmouseenter="this.style.backgroundColor='var(--color-text-primary)';this.style.color='var(--color-surface)'"
              onmouseleave="this.style.backgroundColor='';this.style.color='var(--color-text-primary)'"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              LinkedIn
            </a>
            <a
              href="https://github.com/jaainil"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3 border text-xs font-mono uppercase tracking-widest transition-colors"
              style="border-color: var(--color-text-primary); color: var(--color-text-primary);"
              onmouseenter="this.style.backgroundColor='var(--color-text-primary)';this.style.color='var(--color-surface)'"
              onmouseleave="this.style.backgroundColor='';this.style.color='var(--color-text-primary)'"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              GitHub
            </a>
          </div>
        </div>
        <div class="flex-shrink-0">
          <img
            src="https://storage.rxresu.me/clwlkfh7b0bgqtojz2itm0gc5/pictures/wtpe5ep6q61y0h1fkatnigk6.jpg"
            alt="Jainil Prajapati"
            class="w-48 h-48 md:w-64 md:h-64 object-cover border"
            style="border-color: var(--color-border);"
          />
        </div>
      </div>
    </section>

    <!-- Contact Info -->
    <section class="border-b px-6 md:px-8 py-8" style="border-color: var(--color-border);">
      <div class="flex flex-wrap gap-6 md:gap-12">
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--color-text-muted);">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <a href="mailto:jainilprajapati9@gmail.com" class="text-sm font-mono" style="color: var(--color-text-secondary);" onmouseenter="this.style.color='var(--color-text-primary)'" onmouseleave="this.style.color='var(--color-text-secondary)'">jainilprajapati9@gmail.com</a>
        </div>
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--color-text-muted);">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span class="text-sm font-mono" style="color: var(--color-text-secondary);">+91 9725284302</span>
        </div>
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--color-text-muted);">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span class="text-sm font-mono" style="color: var(--color-text-secondary);">Anand, Gujarat, India</span>
        </div>
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--color-text-muted);">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
          </svg>
          <a href="https://jaainil.com" target="_blank" rel="noopener noreferrer" class="text-sm font-mono" style="color: var(--color-text-secondary);" onmouseenter="this.style.color='var(--color-text-primary)'" onmouseleave="this.style.color='var(--color-text-secondary)'">jaainil.com</a>
        </div>
      </div>
    </section>

    <!-- Experience Section -->
    <section class="border-b px-6 md:px-8 py-16" style="border-color: var(--color-border);">
      <h2 class="text-sm font-mono font-bold uppercase tracking-widest mb-8" style="color: var(--color-text-primary);">
        // Experience
      </h2>
      <div class="space-y-8">
        <div class="border-l-2 pl-6" style="border-color: var(--color-accent-text);">
          <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-4 mb-2">
            <h3 class="text-xl font-display font-bold" style="color: var(--color-text-primary);">Full Stack Developer</h3>
            <span class="text-xs font-mono uppercase tracking-widest" style="color: var(--color-text-muted);">//</span>
            <a href="https://aexaware.com" target="_blank" rel="noopener noreferrer" class="text-lg font-display font-bold hover:underline" style="color: var(--color-accent-text);" onmouseenter="this.style.color='var(--color-text-primary)'" onmouseleave="this.style.color='var(--color-accent-text)'">Aexawareinfotech Pvt. Ltd.</a>
          </div>
          <p class="text-sm font-mono uppercase tracking-widest mb-4" style="color: var(--color-text-muted);">September 2025 - Present • Vadodara</p>
          <ul class="space-y-2">
            <li class="flex items-start gap-3 text-sm font-sans" style="color: var(--color-text-secondary);">
              <span style="color: var(--color-accent-text);">→</span>
              Managed client communication and translated requirements into technical solutions
            </li>
            <li class="flex items-start gap-3 text-sm font-sans" style="color: var(--color-text-secondary);">
              <span style="color: var(--color-accent-text);">→</span>
              Built and shipped full-stack web applications using Next.js and Node.js
            </li>
            <li class="flex items-start gap-3 text-sm font-sans" style="color: var(--color-text-secondary);">
              <span style="color: var(--color-accent-text);">→</span>
              Handled end-to-end product delivery from design to deployment
            </li>
            <li class="flex items-start gap-3 text-sm font-sans" style="color: var(--color-text-secondary);">
              <span style="color: var(--color-accent-text);">→</span>
              Worked on multiple client projects simultaneously under tight deadlines
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Skills Section -->
    <section class="border-b px-6 md:px-8 py-16" style="border-color: var(--color-border);">
      <h2 class="text-sm font-mono font-bold uppercase tracking-widest mb-8" style="color: var(--color-text-primary);">
        // Skills
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="border p-6 transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)'" onmouseleave="this.style.backgroundColor=''">
          <h3 class="text-base font-display font-bold mb-3" style="color: var(--color-text-primary);">Frontend</h3>
          <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Astro.js, React, Next.js, Remix.js, Vite, TailwindCSS, Radix UI</p>
        </div>
        <div class="border p-6 transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)'" onmouseleave="this.style.backgroundColor=''">
          <h3 class="text-base font-display font-bold mb-3" style="color: var(--color-text-primary);">Backend</h3>
          <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Node.js, Prisma, REST APIs, Stripe Integration</p>
        </div>
        <div class="border p-6 transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)'" onmouseleave="this.style.backgroundColor=''">
          <h3 class="text-base font-display font-bold mb-3" style="color: var(--color-text-primary);">DevOps</h3>
          <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Linux, Docker, Nginx, Vercel, Proxmox, GitHub Actions</p>
        </div>
        <div class="border p-6 transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)'" onmouseleave="this.style.backgroundColor=''">
          <h3 class="text-base font-display font-bold mb-3" style="color: var(--color-text-primary);">Databases</h3>
          <p class="text-sm font-sans" style="color: var(--color-text-secondary);">MySQL, MongoDB</p>
        </div>
        <div class="border p-6 transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)'" onmouseleave="this.style.backgroundColor=''">
          <h3 class="text-base font-display font-bold mb-3" style="color: var(--color-text-primary);">Design Tools</h3>
          <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Photoshop, Illustrator, Figma, Canva</p>
        </div>
        <div class="border p-6 transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)'" onmouseleave="this.style.backgroundColor=''">
          <h3 class="text-base font-display font-bold mb-3" style="color: var(--color-text-primary);">Video Editing</h3>
          <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Adobe Premiere Pro, Adobe After Effects</p>
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section class="border-b px-6 md:px-8 py-16" style="border-color: var(--color-border);">
      <h2 class="text-sm font-mono font-bold uppercase tracking-widest mb-8" style="color: var(--color-text-primary);">
        // Projects
      </h2>
      <div class="space-y-8">
        <!-- Writenex -->
        <div class="border p-6 transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)'" onmouseleave="this.style.backgroundColor=''">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-4">
            <div>
              <a href="https://www.npmjs.com/package/@imjp/writenex-astro" target="_blank" rel="noopener noreferrer" class="text-xl font-display font-bold hover:underline" style="color: var(--color-text-primary);" onmouseenter="this.style.color='var(--color-accent-text)'" onmouseleave="this.style.color='var(--color-text-primary)'">
                Writenex – Open Source CMS for Astro
              </a>
              <span class="ml-3 text-xs font-mono uppercase tracking-widest" style="color: var(--color-text-muted);">Open Source</span>
            </div>
          </div>
          <ul class="space-y-2 mb-4">
            <li class="flex items-start gap-3 text-sm font-sans" style="color: var(--color-text-secondary);">
              <span style="color: var(--color-accent-text);">→</span>
              Forked and revived an abandoned open-source CMS, growing it to 79+ commits and v1.6.4
            </li>
            <li class="flex items-start gap-3 text-sm font-sans" style="color: var(--color-text-secondary);">
              <span style="color: var(--color-accent-text);">→</span>
              Built Fields API, version history, image upload, and MDX support from scratch
            </li>
            <li class="flex items-start gap-3 text-sm font-sans" style="color: var(--color-text-secondary);">
              <span style="color: var(--color-accent-text);">→</span>
              Automated releases using GitHub Actions and Vercel deployment pipelines
            </li>
            <li class="flex items-start gap-3 text-sm font-sans" style="color: var(--color-text-secondary);">
              <span style="color: var(--color-accent-text);">→</span>
              Published as an npm package — npx astro add @imjp/writenex-astro
            </li>
          </ul>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 text-xs font-mono uppercase tracking-widest border" style="border-color: var(--color-border); color: var(--color-text-muted);">Astro</span>
            <span class="px-3 py-1 text-xs font-mono uppercase tracking-widest border" style="border-color: var(--color-border); color: var(--color-text-muted);">TypeScript</span>
            <span class="px-3 py-1 text-xs font-mono uppercase tracking-widest border" style="border-color: var(--color-border); color: var(--color-text-muted);">Open Source</span>
          </div>
        </div>

        <!-- Blog Maker -->
        <div class="border p-6 transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)'" onmouseleave="this.style.backgroundColor=''">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-4">
            <div>
              <a href="https://blog-maker.vercel.app/" target="_blank" rel="noopener noreferrer" class="text-xl font-display font-bold hover:underline" style="color: var(--color-text-primary);" onmouseenter="this.style.color='var(--color-accent-text)'" onmouseleave="this.style.color='var(--color-text-primary)'">
                Blog Maker (SaaS)
              </a>
              <span class="ml-3 text-xs font-mono uppercase tracking-widest" style="color: var(--color-text-muted);">SaaS</span>
            </div>
          </div>
          <ul class="space-y-2 mb-4">
            <li class="flex items-start gap-3 text-sm font-sans" style="color: var(--color-text-secondary);">
              <span style="color: var(--color-accent-text);">→</span>
              Built a SaaS blogging platform supporting multi-user subscriptions, authentication, and secure payments
            </li>
            <li class="flex items-start gap-3 text-sm font-sans" style="color: var(--color-text-secondary);">
              <span style="color: var(--color-accent-text);">→</span>
              Engineered a scalable backend using Next.js API routes with Prisma ORM for efficient data handling
            </li>
            <li class="flex items-start gap-3 text-sm font-sans" style="color: var(--color-text-secondary);">
              <span style="color: var(--color-accent-text);">→</span>
              Integrated Stripe to support recurring payments and one-time purchases with real-time billing flows
            </li>
            <li class="flex items-start gap-3 text-sm font-sans" style="color: var(--color-text-secondary);">
              <span style="color: var(--color-accent-text);">→</span>
              Optimized performance for &lt;200ms page loads; improved accessibility using Radix UI components
            </li>
          </ul>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 text-xs font-mono uppercase tracking-widest border" style="border-color: var(--color-border); color: var(--color-text-muted);">Next.js</span>
            <span class="px-3 py-1 text-xs font-mono uppercase tracking-widest border" style="border-color: var(--color-border); color: var(--color-text-muted);">Prisma</span>
            <span class="px-3 py-1 text-xs font-mono uppercase tracking-widest border" style="border-color: var(--color-border); color: var(--color-text-muted);">Stripe</span>
            <span class="px-3 py-1 text-xs font-mono uppercase tracking-widest border" style="border-color: var(--color-border); color: var(--color-text-muted);">Radix UI</span>
          </div>
        </div>

        <!-- Shravonix -->
        <div class="border p-6 transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)'" onmouseleave="this.style.backgroundColor=''">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-4">
            <div>
              <a href="https://shravonix.com" target="_blank" rel="noopener noreferrer" class="text-xl font-display font-bold hover:underline" style="color: var(--color-text-primary);" onmouseenter="this.style.color='var(--color-accent-text)'" onmouseleave="this.style.color='var(--color-text-primary)'">
                Shravonix — AI Tech Blog
              </a>
              <span class="ml-3 text-xs font-mono uppercase tracking-widest" style="color: var(--color-text-muted);">5K+ Monthly Readers</span>
            </div>
          </div>
          <ul class="space-y-2 mb-4">
            <li class="flex items-start gap-3 text-sm font-sans" style="color: var(--color-text-secondary);">
              <span style="color: var(--color-accent-text);">→</span>
              Built the entire site from scratch using Astro focused on performance and SEO
            </li>
            <li class="flex items-start gap-3 text-sm font-sans" style="color: var(--color-text-secondary);">
              <span style="color: var(--color-accent-text);">→</span>
              Achieved 90+ PageSpeed score across all pages with optimized Core Web Vitals
            </li>
            <li class="flex items-start gap-3 text-sm font-sans" style="color: var(--color-text-secondary);">
              <span style="color: var(--color-accent-text);">→</span>
              Integrated Writenex CMS (self-built) for content management
            </li>
            <li class="flex items-start gap-3 text-sm font-sans" style="color: var(--color-text-secondary);">
              <span style="color: var(--color-accent-text);">→</span>
              Grew to 5K+ monthly readers covering LLMs, open-source AI, and developer workflows
            </li>
          </ul>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 text-xs font-mono uppercase tracking-widest border" style="border-color: var(--color-border); color: var(--color-text-muted);">Astro</span>
            <span class="px-3 py-1 text-xs font-mono uppercase tracking-widest border" style="border-color: var(--color-border); color: var(--color-text-muted);">SEO</span>
            <span class="px-3 py-1 text-xs font-mono uppercase tracking-widest border" style="border-color: var(--color-border); color: var(--color-text-muted);">90+ PageSpeed</span>
          </div>
