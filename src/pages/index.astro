---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Figure from '../components/Figure.astro';
import CameraRender from '../components/hardware/CameraRender.astro';
import { services, processPhases, industries, productCatalog, contact } from '../data/site';

const coverageCities = ['Anand', 'Nadiad', 'Kheda', 'Ahmedabad', 'Vadodara', 'Across Gujarat'];
const whyRows = [
  {
    title: 'Storage sized before purchase',
    body: 'We calculate recorder capacity from your retention period and camera count, so footage from month eight still exists when you need it.',
  },
  {
    title: 'Network planned, not improvised',
    body: 'Switch capacity, PoE budgets and cabling routes are part of the drawing. Your cameras never fight your office internet for bandwidth.',
  },
  {
    title: 'Documentation handed over',
    body: 'Camera map, logins, cable schedule and warranty records in one file. The system is yours; you can service it anywhere.',
  },
];
---

<BaseLayout>
  <div class="focus-pull">
    {/* ================= HERO ================= */}
    <section class="border-b border-[var(--seam)]">
      <div class="mx-auto grid max-w-7xl gap-12 px-4 py-14 sm:px-6 lg:grid-cols-12 lg:gap-10 lg:py-20">
        <div class="flex flex-col justify-center lg:col-span-6">
          <h1 class="display text-[2.5rem] sm:text-6xl lg:text-[4rem]">
            We design CCTV systems.<br />
            <span class="text-[var(--blue-deep)]">We don't just sell them.</span>
          </h1>
          <p class="measure mt-6 text-lg leading-relaxed text-[var(--ink-mid)]">
            Shravonix supplies and installs surveillance for factories, offices, institutions, shops and homes across
            Anand and Nadiad. Every job starts with a free site survey and a written design, so you know exactly what
            you are getting before you spend.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              href="/contact#survey"
              class="group flex items-center gap-2.5 rounded-md bg-[var(--blue)] px-6 py-3.5 text-sm font-bold text-white transition-colors hover:bg-[var(--blue-deep)]"
            >
              Book a free site survey
              <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
            </a>
            <a
              href={contact.phoneHref}
              class="flex items-center gap-2.5 rounded-md border border-[var(--seam-strong)] bg-[var(--card)] px-6 py-3.5 text-sm font-semibold text-[var(--ink)] transition-colors hover:border-[var(--blue)] hover:text-[var(--blue-deep)]"
            >
              <Icon name="phone" class="h-4 w-4" />
              {contact.phoneDisplay}
            </a>
          </div>

          <dl class="mt-10 flex flex-wrap gap-x-8 gap-y-3">
            {
              [
                ['Supply', 'Genuine hardware, dealer pricing'],
                ['Install', 'Designed, labelled, documented'],
                ['Maintain', 'AMC with priority response'],
              ].map(([term, def]) => (
                <div>
                  <dt class="data text-[var(--blue-deep)]">{term}</dt>
                  <dd class="mt-1 text-sm text-[var(--ink-mid)]">{def}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="flex flex-col justify-center lg:col-span-6">
          <div class="pull pull-2">
            <Figure fig="Fig. 01" caption="IR Bullet · perimeter" stamp="Surveyed">
              <CameraRender kind="bullet" class="h-auto w-full" />
            </Figure>
            <div class="mt-3 flex flex-wrap gap-2">
              {
                ['4 MP · IR 40 m', 'IP67 weather-sealed', 'PoE'].map((chip) => (
                  <span class="data rounded border border-[var(--seam-strong)] bg-[var(--card)] px-2 py-1 text-[var(--ink-mid)]">{chip}</span>
                ))
              }
            </div>
          </div>
          <div class="pull pull-3 mt-6 grid grid-cols-2 gap-4">
            <Figure fig="Fig. 02" caption="Vandal Dome · indoor">
              <CameraRender kind="dome" class="h-auto w-full" />
            </Figure>
            <Figure fig="Fig. 03" caption="NVR · 16 CH" stamp="AMC ready">
              <CameraRender kind="nvr" class="h-auto w-full" />
            </Figure>
          </div>
          <p class="pull data mt-4 text-[var(--ink-low)]">Illustrative renders — exact models quoted after survey</p>
        </div>
      </div>

      {/* coverage strip */}
      <div class="border-t border-[var(--seam)] bg-[var(--card)]">
        <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3.5 sm:px-6">
          <span class="flex items-center gap-2">
            <Icon name="pin" class="h-4 w-4 text-[var(--blue-deep)]" />
            <span class="data text-[var(--ink-low)]">Coverage</span>
          </span>
          {coverageCities.map((c) => <span class="data text-[var(--ink-mid)]">{c}</span>)}
          <span class="data ml-auto hidden text-[var(--ink-low)] md:inline">{contact.cities.join(' & ')} based · on-site support</span>
        </div>
      </div>
    </section>

    {/* ================= SERVICES ================= */}
    <section class="border-b border-[var(--seam)]">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-24">
        <div class="reveal max-w-3xl">
          <h2 class="subdisplay text-3xl sm:text-4xl">Dealership hardware. Engineering discipline.</h2>
          <p class="measure mt-4 text-[var(--ink-mid)]">
            The dealership gets you genuine cameras at fair prices. The engineering gets you a system that is placed
            right, cabled clean and documented. You want both.
          </p>
        </div>

        <div class="mt-12 grid gap-6 lg:grid-cols-12">
          {
            services.map((s, i) => (
              <article class:list={['plate bolted reveal relative p-7 sm:p-9', i === 0 ? 'lg:col-span-7' : 'lg:col-span-5']}>
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <Icon name={i === 0 ? 'cctv' : 'wrench'} class="h-6 w-6 text-[var(--blue-deep)]" />
                    <h3 class="subdisplay mt-4 text-2xl">{s.title}</h3>
                  </div>
                  <span class="data hidden rounded border border-[var(--seam-strong)] px-2 py-1 text-[var(--ink-low)] sm:inline">
                    {i === 0 ? 'Ref. SV-01' : 'Ref. SV-02'}
                  </span>
                </div>
                <p class="mt-3 max-w-xl text-[var(--ink-mid)]">{s.short}</p>
                <ul class="mt-6 space-y-2.5">
                  {s.points.slice(0, 4).map((p) => (
                    <li class="flex items-start gap-2.5 text-sm text-[var(--ink-mid)]">
                      <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-[var(--green)]" />
                      {p}
                    </li>
                  ))}
                </ul>
                <a
                  href={`/services/${s.slug}`}
                  class="group mt-7 inline-flex items-center gap-2 text-sm font-semibold text-[var(--blue-deep)] transition-colors hover:text-[var(--blue)]"
                >
                  {i === 0 ? 'Supply & installation' : 'AMC & monitoring'}
                  <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {/* ================= PROCESS ================= */}
    <section class="border-b border-[var(--seam)] bg-[var(--card)]">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-24">
        <div class="reveal max-w-3xl">
          <h2 class="subdisplay text-3xl sm:text-4xl">Four phases. Nothing skipped.</h2>
          <p class="measure mt-4 text-[var(--ink-mid)]">
            Nothing is bought before the design is approved, and nothing is left undocumented after the install. The
            same four steps on every job, from a single shop to a factory campus.
          </p>
        </div>

        <ol class="reveal mt-12 grid gap-px overflow-hidden rounded-lg border border-[var(--seam)] bg-[var(--seam)] sm:grid-cols-2 lg:grid-cols-4">
          {
            processPhases.map((phase, i) => (
              <li class="relative flex flex-col bg-[var(--paper)] p-6 lg:p-7">
                <div class="flex items-center justify-between">
                  <span class="data flex h-8 w-8 items-center justify-center rounded-full border border-[var(--blue-deep)] bg-[var(--card)] font-bold text-[var(--blue-deep)]">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  {i === 0 && <span class="stamp data text-[var(--green)]">Free</span>}
                </div>
                <h3 class="subdisplay mt-5 text-lg">{phase.title}</h3>
                <p class="mt-2.5 flex-1 text-sm leading-relaxed text-[var(--ink-mid)]">{phase.body}</p>
                <p class="data mt-5 border-t border-[var(--seam)] pt-3.5 normal-case text-[var(--ink-low)]">{phase.deliverable}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* ================= PRODUCTS ================= */}
    <section class="border-b border-[var(--seam)]">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-24">
        <div class="reveal flex flex-wrap items-end justify-between gap-4">
          <div class="max-w-2xl">
            <h2 class="subdisplay text-3xl sm:text-4xl">Hardware, spec'd plainly.</h2>
            <p class="measure mt-4 text-[var(--ink-mid)]">
              The camera lines we deal in. Exact models and prices come with your survey quote, because the right
              camera depends on the site.
            </p>
          </div>
          <a href="/products" class="group flex items-center gap-2 text-sm font-semibold text-[var(--blue-deep)] transition-colors hover:text-[var(--blue)]">
            Full catalogue
            <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
          </a>
        </div>

        <div class="reveal mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {
            productCatalog.map((cat, i) => (
              <a href={`/products#${cat.id}`} class="plate group flex flex-col p-5 transition-colors hover:border-[var(--blue)]">
                <div class="bg-[var(--card)]">
                  <CameraRender kind={cat.art} class="h-auto w-full" />
                </div>
                <h3 class="subdisplay mt-4 text-base">{cat.title}</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--ink-mid)]">{cat.intro}</p>
                <span class="data mt-4 flex items-center gap-1.5 text-[var(--blue-deep)]">
                  {cat.models.length} line{cat.models.length > 1 ? 's' : ''} · Fig. {String(i + 1).padStart(2, '0')}
                  <Icon name="arrow" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {/* ================= INDUSTRIES ================= */}
    <section class="border-b border-[var(--seam)] bg-[var(--card)]">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-24">
        <div class="reveal max-w-3xl">
          <h2 class="subdisplay text-3xl sm:text-4xl">Sites we know.</h2>
          <p class="measure mt-4 text-[var(--ink-mid)]">
            A factory floor and a showroom need very different camera plans. We design for the site in front of us.
          </p>
        </div>

        <div class="reveal mt-10 grid gap-px overflow-hidden rounded-lg border border-[var(--seam)] bg-[var(--seam)] md:grid-cols-2">
          {
            industries.map((ind) => (
              <div class="flex flex-col gap-2 bg-[var(--paper)] p-6 sm:flex-row sm:items-start sm:gap-5">
                <h3 class="subdisplay shrink-0 text-base sm:w-56">{ind.title}</h3>
                <p class="text-sm leading-relaxed text-[var(--ink-mid)]">{ind.body}</p>
              </div>
            ))
          }
        </div>
        <a href="/industries" class="reveal group mt-8 inline-flex items-center gap-2 text-sm font-semibold text-[var(--blue-deep)] transition-colors hover:text-[var(--blue)]">
          Detail by industry
          <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
        </a>
      </div>
    </section>

    {/* ================= WHY ================= */}
    <section class="border-b border-[var(--seam)]">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-24">
        <div class="grid gap-10 lg:grid-cols-12">
          <div class="reveal lg:col-span-5">
            <h2 class="display text-3xl sm:text-4xl lg:text-[2.8rem]">
              Signal <span class="text-[var(--blue-deep)]">over</span> noise.
            </h2>
            <p class="measure mt-5 text-[var(--ink-mid)]">
              Surveillance sales run on jargon and fear. We quote from a drawing, with numbers, and hand over a file
              that proves the work. It is the same discipline our engineers bring to networks, pointed at your
              perimeter.
            </p>
            <a href="/about" class="group mt-7 inline-flex items-center gap-2 text-sm font-semibold text-[var(--blue-deep)] transition-colors hover:text-[var(--blue)]">
              About Shravonix
              <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
            </a>
          </div>
          <div class="lg:col-span-7">
            <ul class="seams border-y border-[var(--seam)]">
              {
                whyRows.map((row) => (
                  <li class="reveal grid gap-2 py-6 md:grid-cols-12 md:gap-6">
                    <h3 class="subdisplay text-base md:col-span-4">{row.title}</h3>
                    <p class="text-sm leading-relaxed text-[var(--ink-mid)] md:col-span-8">{row.body}</p>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* ================= FINAL CTA ================= */}
    <section class="bg-[var(--card)]">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-24">
        <div class="plate bolted reveal p-8 sm:p-12 lg:p-16">
          <div class="grid items-center gap-8 lg:grid-cols-12">
            <div class="lg:col-span-8">
              <h2 class="display text-3xl sm:text-4xl lg:text-5xl">Book a free site survey.</h2>
              <p class="measure mt-5 text-[var(--ink-mid)]">
                We walk the site, mark where cameras should go, and hand you a written estimate. No obligation. You
                decide with the plan in your hand.
              </p>
              <div class="mt-8 flex flex-wrap gap-3">
                <a
                  href="/contact#survey"
                  class="group flex items-center gap-2.5 rounded-md bg-[var(--blue)] px-6 py-3.5 text-sm font-bold text-white transition-colors hover:bg-[var(--blue-deep)]"
                >
                  Request the survey
                  <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
                </a>
                <a
                  href={contact.phoneHref}
                  class="flex items-center gap-2.5 rounded-md border border-[var(--seam-strong)] bg-[var(--card)] px-6 py-3.5 text-sm font-semibold text-[var(--ink)] transition-colors hover:border-[var(--blue)] hover:text-[var(--blue-deep)]"
                >
                  <Icon name="phone" class="h-4 w-4" />
                  {contact.phoneDisplay}
                </a>
              </div>
            </div>
            <div class="lg:col-span-4">
              <div class="plate-tint p-5">
                <p class="data text-[var(--ink-low)]">Included in every survey</p>
                <ul class="mt-3 space-y-2 text-sm text-[var(--ink-mid)]">
                  <li class="flex items-start gap-2">
                    <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-[var(--green)]" />
                    Camera positions marked on your layout
                  </li>
                  <li class="flex items-start gap-2">
                    <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-[var(--green)]" />
                    Camera count and budget estimate
                  </li>
                  <li class="flex items-start gap-2">
                    <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-[var(--green)]" />
                    Honest answer on what you don't need
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
