---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Schema } from 'astro-seo-schema';

const SITE_URL = 'https://jaainil.com';
const pageUrl = `${SITE_URL}/about`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'About', item: pageUrl },
  ],
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${pageUrl}#webpage`,
  name: 'About Jainil Prajapati — Full-Stack Developer',
  description: 'Learn about Jainil Prajapati, a Full-Stack Developer passionate about building scalable SaaS platforms and contributing to open-source ecosystems.',
  url: pageUrl,
  inLanguage: 'en',
  isPartOf: { '@id': `${SITE_URL}/#website` },
  about: { '@id': `${SITE_URL}/#person` },
};
---

<BaseLayout
  title="About — Jainil Prajapati"
  description="Learn about Jainil Prajapati, a Full-Stack Developer passionate about building scalable SaaS platforms and contributing to open-source ecosystems."
>
  <Fragment slot="head">
    <Schema item={breadcrumbSchema as any} />
    <Schema item={webPageSchema as any} />
  </Fragment>
  <div class="w-full pb-16">
    
    <!-- Page heading -->
    <div class="border-b px-6 md:px-8 py-8" style="border-color: var(--color-border);">
      <p class="text-[11px] font-mono uppercase tracking-widest mb-2" style="color: var(--color-text-muted);">// About</p>
      <h1 class="text-4xl md:text-5xl font-display font-bold tracking-tight" style="color: var(--color-text-primary);">
        About Me
      </h1>
    </div>

    <!-- Profile Section -->
    <section class="border-b px-6 md:px-8 py-16" style="border-color: var(--color-border);">
      <div class="flex flex-col lg:flex-row gap-12 items-start">
        <div class="flex-1">
          <p class="text-lg font-sans leading-relaxed mb-6" style="color: var(--color-text-secondary);">
            I'm a Full-Stack Developer passionate about building scalable SaaS platforms and contributing to open-source ecosystems. Based in Anand, Gujarat, India, I specialize in crafting high-performance web applications and maintaining open-source projects.
          </p>
          <p class="text-lg font-sans leading-relaxed mb-6" style="color: var(--color-text-secondary);">
            Currently working at <a href="https://aexaware.com" target="_blank" rel="noopener noreferrer" class="hover:underline" style="color: var(--color-accent-text);" onmouseenter="this.style.color='var(--color-text-primary)'" onmouseleave="this.style.color='var(--color-accent-text)'">Aexawareinfotech Pvt. Ltd.</a> as a Full Stack Developer, I handle end-to-end product delivery from design to deployment, managing client communication and translating requirements into technical solutions.
          </p>
          <p class="text-lg font-sans leading-relaxed" style="color: var(--color-text-secondary);">
            I built and maintain <a href="https://www.npmjs.com/package/@imjp/writenex-astro" target="_blank" rel="noopener noreferrer" class="hover:underline" style="color: var(--color-accent-text);" onmouseenter="this.style.color='var(--color-text-primary)'" onmouseleave="this.style.color='var(--color-accent-text)'">Writenex CMS</a> (npm published), run <a href="https://shravonix.com" target="_blank" rel="noopener noreferrer" class="hover:underline" style="color: var(--color-accent-text);" onmouseenter="this.style.color='var(--color-text-primary)'" onmouseleave="this.style.color='var(--color-accent-text)'">Shravonix</a> with 5K+ monthly readers, and actively contribute to Dokploy's open-source templates.
          </p>
        </div>
        <div class="flex-shrink-0">
          <img
            src="https://storage.rxresu.me/clwlkfh7b0bgqtojz2itm0gc5/pictures/wtpe5ep6q61y0h1fkatnigk6.jpg"
            alt="Jainil Prajapati"
            class="w-48 h-48 md:w-64 md:h-64 object-cover border"
            style="border-color: var(--color-border);"
          />
        </div>
      </div>
    </section>

    <!-- What I Do -->
    <section class="border-b px-6 md:px-8 py-16" style="border-color: var(--color-border);">
      <div class="max-w-3xl">
        <h2 class="text-sm font-mono font-bold uppercase tracking-widest mb-6" style="color: var(--color-text-primary);">
          // What I Do
        </h2>
        <div class="space-y-4">
          <div class="flex items-start gap-4">
            <span class="text-xs font-mono uppercase tracking-widest mt-1" style="color: var(--color-accent-text);">01</span>
            <div>
              <h3 class="text-base font-display font-bold mb-2" style="color: var(--color-text-primary);">Full-Stack Development</h3>
              <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Building scalable web applications using Next.js, Node.js, Astro, and modern frameworks with clean architecture and best practices.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <span class="text-xs font-mono uppercase tracking-widest mt-1" style="color: var(--color-accent-text);">02</span>
            <div>
              <h3 class="text-base font-display font-bold mb-2" style="color: var(--color-text-primary);">Open Source</h3>
              <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Contributing to and maintaining open-source projects. Built Writenex CMS and actively contribute to Dokploy templates.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <span class="text-xs font-mono uppercase tracking-widest mt-1" style="color: var(--color-accent-text);">03</span>
            <div>
              <h3 class="text-base font-display font-bold mb-2" style="color: var(--color-text-primary);">SaaS Products</h3>
              <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Building and deploying SaaS platforms with subscription management, secure payments via Stripe, and optimized performance.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <span class="text-xs font-mono uppercase tracking-widest mt-1" style="color: var(--color-accent-text);">04</span>
            <div>
              <h3 class="text-base font-display font-bold mb-2" style="color: var(--color-text-primary);">Performance & SEO</h3>
              <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Achieving 90+ PageSpeed scores through optimized Core Web Vitals, efficient rendering strategies, and SEO best practices.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Tech Stack -->
    <section class="border-b px-6 md:px-8 py-16" style="border-color: var(--color-border);">
      <h2 class="text-sm font-mono font-bold uppercase tracking-widest mb-6" style="color: var(--color-text-primary);">
        // Tech Stack
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="border p-6 transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)'" onmouseleave="this.style.backgroundColor=''">
          <h3 class="text-base font-display font-bold mb-3" style="color: var(--color-text-primary);">Frontend</h3>
          <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Astro.js, React, Next.js, Remix.js, Vite, TailwindCSS, Radix UI</p>
        </div>
        <div class="border p-6 transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)'" onmouseleave="this.style.backgroundColor=''">
          <h3 class="text-base font-display font-bold mb-3" style="color: var(--color-text-primary);">Backend</h3>
          <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Node.js, Prisma, REST APIs, Stripe Integration</p>
        </div>
        <div class="border p-6 transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)'" onmouseleave="this.style.backgroundColor=''">
          <h3 class="text-base font-display font-bold mb-3" style="color: var(--color-text-primary);">DevOps</h3>
          <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Linux, Docker, Nginx, Vercel, Proxmox, GitHub Actions</p>
        </div>
        <div class="border p-6 transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)'" onmouseleave="this.style.backgroundColor=''">
          <h3 class="text-base font-display font-bold mb-3" style="color: var(--color-text-primary);">Databases</h3>
          <p class="text-sm font-sans" style="color: var(--color-text-secondary);">MySQL, MongoDB</p>
        </div>
        <div class="border p-6 transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)'" onmouseleave="this.style.backgroundColor=''">
          <h3 class="text-base font-display font-bold mb-3" style="color: var(--color-text-primary);">Design Tools</h3>
          <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Photoshop, Illustrator, Figma, Canva</p>
        </div>
        <div class="border p-6 transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.backgroundColor='var(--color-hover)'" onmouseleave="this.style.backgroundColor=''">
          <h3 class="text-base font-display font-bold mb-3" style="color: var(--color-text-primary);">Video Editing</h3>
          <p class="text-sm font-sans" style="color: var(--color-text-secondary);">Adobe Premiere Pro, Adobe After Effects</p>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="border-b px-6 md:px-8 py-16" style="border-color: var(--color-border);">
      <div class="max-w-3xl">
        <h2 class="text-sm font-mono font-bold uppercase tracking-widest mb-6" style="color: var(--color-text-primary);">
          // Get in Touch
        </h2>
        <div class="space-y-6">
          <p class="text-base font-sans leading-relaxed" style="color: var(--color-text-secondary);">
            Interested in working together or have a project in mind? I'd love to hear from you.
          </p>
          <div class="flex flex-wrap gap-4">
            <a
              href="mailto:jainilprajapati9@gmail.com"
              class="inline-flex items-center gap-2 px-6 py-3 border text-xs font-mono uppercase tracking-widest transition-colors"
              style="border-color: var(--color-text-primary); color: var(--color-text-primary);"
              onmouseenter="this.style.backgroundColor='var(--color-text-primary)';this.style.color='var(--color-surface)'"
              onmouseleave="this.style.backgroundColor='';this.style.color='var(--color-text-primary)'"
            >
              Email Me
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            <a
              href="https://www.linkedin.com/in/jaainil/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3 border text-xs font-mono uppercase tracking-widest transition-colors"
              style="border-color: var(--color-text-primary); color: var(--color-text-primary);"
              onmouseenter="this.style.backgroundColor='var(--color-text-primary)';this.style.color='var(--color-surface)'"
              onmouseleave="this.style.backgroundColor='';this.style.color='var(--color-text-primary)'"
            >
              LinkedIn
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            <a
              href="https://github.com/jaainil"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3 border text-xs font-mono uppercase tracking-widest transition-colors"
              style="border-color: var(--color-text-primary); color: var(--color-text-primary);"
              onmouseenter="this.style.backgroundColor='var(--color-text-primary)';this.style.color='var(--color-surface)'"
              onmouseleave="this.style.backgroundColor='';this.style.color='var(--color-text-primary)'"
            >
              GitHub
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>