---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { industries } from '../data/site';
---

<BaseLayout
  title="Industries We Serve — Shravonix · Anand, Nadiad, Gujarat"
  description="CCTV coverage designed per vertical: factories, warehouses, offices, education, healthcare, retail and homes across Anand–Nadiad and Gujarat."
>
  <section class="border-b border-[var(--seam)]">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:py-20">
      <h1 class="display max-w-4xl text-4xl sm:text-5xl lg:text-[3.4rem]">Built for the sites we actually visit.</h1>
      <p class="measure mt-6 text-lg leading-relaxed text-[var(--ink-mid)]">
        A camera plan for a factory floor looks nothing like one for a showroom. Same hardware family — different
        placement, weatherproofing, retention and privacy boundaries. This is what we design for, vertical by vertical.
      </p>
    </div>
  </section>

  <section class="border-b border-[var(--seam)]">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:py-20">
      <div class="grid gap-6 md:grid-cols-2">
        {
          industries.map((ind) => (
            <article class="plate bolted reveal flex flex-col p-7">
              <h2 class="subdisplay text-xl">{ind.title}</h2>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-[var(--ink-mid)]">{ind.body}</p>
              <ul class="mt-5 flex flex-wrap gap-2 border-t border-[var(--seam)] pt-5">
                {ind.coverage.map((c) => (
                  <li class="data flex items-center gap-1.5 rounded border border-[var(--seam-strong)] px-2 py-1 text-[var(--ink-mid)]">
                    <Icon name="pin" class="h-3 w-3 text-[var(--blue-deep)]" />
                    {c}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-[var(--seam)] bg-[var(--card)]">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
      <div class="reveal grid gap-8 lg:grid-cols-2">
        <div>
          <h2 class="subdisplay text-2xl">Privacy is part of the design.</h2>
          <p class="measure mt-4 text-[var(--ink-mid)]">
            Cameras do not go where they should not. Work areas, rest rooms, neighbour boundaries — a compliant layout
            is part of the survey drawing, not an afterthought. Your staff see the plan before a single bracket is
            drilled.
          </p>
        </div>
        <div>
          <h2 class="subdisplay text-2xl">B2B and B2C, same discipline.</h2>
          <p class="measure mt-4 text-[var(--ink-mid)]">
            Enterprises get the full four-phase process. Homes and small shops get the same survey-and-design honesty,
            scaled down — a smaller system, not a lesser one.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
