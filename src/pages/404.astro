---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Page not found — Shravonix" description="This page is not on file.">
  <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:py-36">
    <div class="plate mx-auto max-w-2xl overflow-hidden">
      <div class="flex items-center justify-between border-b border-[var(--seam)] px-5 py-3">
        <span class="data rounded border border-[var(--seam-strong)] px-1.5 py-0.5 text-[var(--ink-mid)]">Ref. 404</span>
        <span class="stamp data text-[var(--amber)]">Not on file</span>
      </div>
      <div class="bg-[var(--card)] px-6 py-14 text-center sm:px-10">
        <h1 class="display text-4xl sm:text-5xl">This page is not on file.</h1>
        <p class="measure mx-auto mt-5 text-[var(--ink-mid)]">
          The page you asked for does not exist or has moved. Head back to base and pick up from there.
        </p>
        <a
          href="/"
          class="group mt-8 inline-flex items-center gap-2.5 rounded-md bg-[var(--blue)] px-6 py-3.5 text-sm font-bold text-white transition-colors hover:bg-[var(--blue-deep)]"
        >
          Back to home
          <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
