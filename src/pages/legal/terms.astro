---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { marked } from 'marked';
import fs from 'node:fs';
import path from 'node:path';
import { site } from '../../data/site';

const filePath = path.join(process.cwd(), 'public/policies/terms-of-service.md');
const content = marked.parse(fs.readFileSync(filePath, 'utf-8'));
---

<BaseLayout title={`Terms of Service — ${site.name}`} description={`Terms of service for ${site.url}.`}>
  <section class="border-b border-[var(--seam)]">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
      <h1 class="display text-4xl sm:text-5xl">Terms of service</h1>
      <p class="data mt-4 text-[var(--ink-low)]">Last updated: January 1, 2026</p>
    </div>
  </section>
  <section>
    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
      <div class="prose-dark" set:html={content} />
    </div>
  </section>
</BaseLayout>
