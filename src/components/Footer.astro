---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { contact, site, services } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="plate-ink mt-0 border-t border-[var(--seam-strong)]">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-5">
        <div class="flex items-center gap-3">
          <img src="/mark.png" alt="" width="34" height="32" class="w-[34px] h-auto" loading="lazy" decoding="async" />
          <span class="display text-base tracking-tight text-white leading-none">Shravonix</span>
        </div>
        <p class="data mt-4 text-[#8fb4ff]">{site.tagline}</p>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-[#b9c4d8]">
          CCTV surveillance systems, supplied, installed and maintained for enterprises, businesses and homes across Anand, Nadiad and Gujarat.
        </p>
        <p class="data mt-5 flex items-center gap-2 text-[#8b98b3]">
          <Icon name="pin" class="h-4 w-4 text-[#8fb4ff]" />
          {contact.cities.join(' & ')} · {contact.region}
        </p>
      </div>

      <nav class="md:col-span-2" aria-label="Services">
        <h2 class="data text-[#8b98b3]">Services</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            services.map((s) => (
              <li>
                <a href={`/services/${s.slug}`} class="text-[#b9c4d8] transition-colors hover:text-white">
                  {s.title}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/products" class="text-[#b9c4d8] transition-colors hover:text-white">Products</a>
          </li>
        </ul>
      </nav>

      <nav class="md:col-span-2" aria-label="Company">
        <h2 class="data text-[#8b98b3]">Company</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a href="/industries" class="text-[#b9c4d8] transition-colors hover:text-white">Industries</a></li>
          <li><a href="/about" class="text-[#b9c4d8] transition-colors hover:text-white">About</a></li>
          <li><a href="/contact" class="text-[#b9c4d8] transition-colors hover:text-white">Contact</a></li>
          <li><a href="/legal/privacy" class="text-[#b9c4d8] transition-colors hover:text-white">Privacy</a></li>
          <li><a href="/legal/terms" class="text-[#b9c4d8] transition-colors hover:text-white">Terms</a></li>
        </ul>
      </nav>

      <div class="md:col-span-3">
        <h2 class="data text-[#8b98b3]">Direct line</h2>
        <ul class="mt-4 space-y-3 text-sm">
          <li>
            <a href={contact.phoneHref} class="flex items-center gap-2.5 text-[#b9c4d8] transition-colors hover:text-white">
              <Icon name="phone" class="h-4 w-4 text-[#8fb4ff]" />
              {contact.phoneDisplay}
            </a>
          </li>
          <li>
            <a href={`mailto:${contact.email}`} class="flex items-center gap-2.5 text-[#b9c4d8] transition-colors hover:text-white">
              <Icon name="mail" class="h-4 w-4 text-[#8fb4ff]" />
              {contact.email}
            </a>
          </li>
          <li>
            <a href={contact.whatsappHref} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2.5 text-[#b9c4d8] transition-colors hover:text-white">
              <Icon name="whatsapp" class="h-4 w-4 text-[#8fb4ff]" />
              WhatsApp us
            </a>
          </li>
          <li class="flex items-center gap-2.5 text-[#8b98b3]">
            <Icon name="clock" class="h-4 w-4" />
            {contact.hours}
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-[#223049] pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="data text-[#8b98b3]">© {year} {site.name} · Anand & Nadiad, Gujarat</p>
      <p class="data text-[#8b98b3]"><a href="/legal/cookies" class="transition-colors hover:text-[#b9c4d8]">Cookie policy</a></p>
    </div>
  </div>
</footer>
