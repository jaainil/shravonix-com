---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<a href="/" class={`flex items-center gap-3 group ${className}`} aria-label="Shravonix — home">
  <img src="/mark.png" alt="" width="34" height="32" class="w-[34px] h-auto" loading="eager" decoding="async" />
  <span class="display text-[15px] sm:text-base tracking-tight text-[var(--ink)] leading-none">
    Shravonix
  </span>
</a>
