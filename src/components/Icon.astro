---
/**
 * House icon set — authored SVG, one consistent 1.6 stroke at 24px.
 * Geometry, not illustration.
 */
interface Props {
  name:
    | 'cctv'
    | 'shield'
    | 'wrench'
    | 'eye'
    | 'pin'
    | 'phone'
    | 'mail'
    | 'whatsapp'
    | 'arrow'
    | 'check'
    | 'clock'
    | 'stack'
    | 'network'
    | 'menu'
    | 'close';
  class?: string;
}
const { name, class: className = 'w-5 h-5' } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {
    name === 'cctv' && (
      <>
        <rect x="2.5" y="5" width="14" height="7.5" rx="2.5" />
        <circle cx="13.4" cy="8.75" r="1.6" />
        <path d="M16.5 9.5 L20.5 12.2 M8 15.5 L8 19 M4.8 19 L11.2 19 M2.5 8.2 L5 7.4" />
      </>
    )
  }
  {
    name === 'shield' && (
      <>
        <path d="M12 2.8 L20 6 v5.5 c0 5-3.4 8.3-8 9.7 -4.6-1.4-8-4.7-8-9.7 V6 Z" />
        <path d="M8.8 11.8 l2.3 2.3 4.1-4.4" />
      </>
    )
  }
  {
    name === 'wrench' && (
      <path d="M14.5 6.5 a4.5 4.5 0 0 0-6 5.6 L3 17.6 a2 2 0 1 0 2.8 2.8 l5.5-5.5 a4.5 4.5 0 0 0 5.7-6 l-3 3 -2.8-.7 -.7-2.8 Z" />
    )
  }
  {
    name === 'eye' && (
      <>
        <path d="M2.5 12 S6 5.8 12 5.8 21.5 12 21.5 12 18 18.2 12 18.2 2.5 12 2.5 12 Z" />
        <circle cx="12" cy="12" r="3" />
      </>
    )
  }
  {
    name === 'pin' && (
      <>
        <path d="M12 21.5 c4-4.4 6.5-7.8 6.5-11 a6.5 6.5 0 1 0-13 0 c0 3.2 2.5 6.6 6.5 11 Z" />
        <circle cx="12" cy="10.2" r="2.4" />
      </>
    )
  }
  {
    name === 'phone' && (
      <path d="M5.5 3.5 h3 l1.7 4.2 -2.1 1.6 a12.5 12.5 0 0 0 6.6 6.6 l1.6-2.1 4.2 1.7 v3 a2 2 0 0 1-2.2 2 A16.5 16.5 0 0 1 3.5 5.7 a2 2 0 0 1 2-2.2 Z" />
    )
  }
  {
    name === 'mail' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2.5" />
        <path d="M3.5 7 L12 13 20.5 7" />
      </>
    )
  }
  {
    name === 'whatsapp' && (
      <>
        <path d="M12 3.2 a8.8 8.8 0 0 0-7.6 13.2 L3.2 20.8 l4.5-1.2 A8.8 8.8 0 1 0 12 3.2 Z" />
        <path d="M9 8.4 c-.6 1.8.6 4.2 2 5.4 1.3 1.1 3.4 1.9 4.6 1.2 .5-.3.8-.9.6-1.4 l-1.6-1 -1 .7 c-1-.4-2.1-1.4-2.6-2.5 l.8-.9 -.8-1.7 c-.4-.5-1.5-.5-2 .2 Z" />
      </>
    )
  }
  {
    name === 'arrow' && <path d="M4 12 h15 M13.5 6.5 L19.5 12 l-6 5.5" />
  }
  {
    name === 'check' && <path d="M4.5 12.5 l5 5 L19.5 7" />
  }
  {
    name === 'clock' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M12 6.8 V12 l3.6 2.2" />
      </>
    )
  }
  {
    name === 'stack' && (
      <>
        <rect x="4" y="4" width="16" height="6" rx="1.5" />
        <rect x="4" y="14" width="16" height="6" rx="1.5" />
        <path d="M7.5 7 h.01 M7.5 17 h.01" />
      </>
    )
  }
  {
    name === 'network' && (
      <>
        <rect x="9" y="3" width="6" height="6" rx="1.5" />
        <rect x="3" y="15" width="6" height="6" rx="1.5" />
        <rect x="15" y="15" width="6" height="6" rx="1.5" />
        <path d="M12 9 v3.5 M6 15 v-2.5 h12 V15" />
      </>
    )
  }
  {
    name === 'menu' && <path d="M4 7 h16 M4 12 h16 M4 17 h16" />
  }
  {name === 'close' && <path d="M6 6 l12 12 M18 6 L6 18" />}
</svg>
