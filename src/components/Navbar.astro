---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { contact } from '../data/site';

const links = [
  { href: '/services/cctv-surveillance', label: 'Services' },
  { href: '/products', label: 'Products' },
  { href: '/industries', label: 'Industries' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-50 border-b border-[var(--seam)] bg-[color-mix(in_srgb,var(--paper)_92%,transparent)] backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-stretch justify-between px-4 sm:px-6">
    <div class="flex items-center">
      <Logo />
    </div>

    <nav class="hidden items-stretch lg:flex" aria-label="Primary">
      {
        links.map((l) => {
          const active = current === l.href || (l.href !== '/' && current.startsWith(l.href));
          return (
            <a
              href={l.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'flex items-center px-4 text-[13px] font-medium tracking-wide transition-colors border-l border-[var(--seam)] last:border-r',
                active ? 'text-[var(--blue-deep)]' : 'text-[var(--ink-mid)] hover:text-[var(--ink)] hover:bg-[var(--tint)]',
              ]}
            >
              {l.label}
            </a>
          );
        })
      }
      <a
        href="/contact#survey"
        class="ml-4 my-2 flex items-center gap-2 self-center rounded-md bg-[var(--blue)] px-4 py-2 text-[13px] font-semibold text-white transition-colors hover:bg-[var(--blue-deep)]"
      >
        Book free site survey
        <Icon name="arrow" class="h-4 w-4" />
      </a>
    </nav>

    <div class="flex items-stretch lg:hidden">
      <button id="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" class="flex items-center px-2 text-[var(--ink-mid)] hover:text-[var(--ink)]">
        <Icon name="menu" class="menu-open h-6 w-6" />
        <Icon name="close" class="menu-close hidden h-6 w-6" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-[var(--seam)] bg-[var(--card)] lg:hidden">
    <nav class="mx-auto max-w-7xl px-4 py-2" aria-label="Mobile">
      {
        links.map((l) => (
          <a href={l.href} class="mobile-link block border-b border-[var(--seam)] py-3 text-sm font-medium text-[var(--ink-mid)] last:border-0 hover:text-[var(--ink)]">
            {l.label}
          </a>
        ))
      }
      <a href="/contact#survey" class="mobile-link mt-2 mb-3 flex items-center justify-center gap-2 rounded-md bg-[var(--blue)] px-4 py-3 text-sm font-semibold text-white">
        Book free site survey
      </a>
      <p class="data pb-4 text-[var(--ink-low)]">{contact.phoneDisplay} · {contact.cities.join(' · ')}</p>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const setOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    btn?.setAttribute('aria-expanded', String(open));
    btn?.querySelector('.menu-open')?.classList.toggle('hidden', open);
    btn?.querySelector('.menu-close')?.classList.toggle('hidden', !open);
  };
  btn?.addEventListener('click', () => setOpen(menu?.classList.contains('hidden') ?? false));
  menu?.querySelectorAll('.mobile-link').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu?.classList.contains('hidden')) {
      setOpen(false);
      btn?.focus();
    }
  });
</script>
